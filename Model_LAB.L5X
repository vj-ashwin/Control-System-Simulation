<AddOnInstructionDefinition Use="Target" Name="Model_LAB" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" SoftwareRevision="v33.00">
<Parameters><Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><Description><![CDATA[Enable Input - System Defined Parameter]]></Description></Parameter><Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><Description><![CDATA[Enable Output - System Defined Parameter]]></Description></Parameter><Parameter Name="Stop" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><Description><![CDATA[Stop]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter><Parameter Name="Forward_PB" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><Description><![CDATA[Forward Push Button]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter><Parameter Name="Reverse_PB" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><Description><![CDATA[Reverse Push Button]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter><Parameter Name="Forward" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><Description><![CDATA[Forward LED]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter><Parameter Name="Forwardmtr" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><Description><![CDATA[Forward Motor LED]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter><Parameter Name="Forwardslow" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><Description><![CDATA[Forward Slow Motor LED]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter><Parameter Name="Temp1" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><Description><![CDATA[Temporary Variable LED]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter><Parameter Name="Reverse" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><Description><![CDATA[Reverse LED LED]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter><Parameter Name="Reversemtr" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><Description><![CDATA[Reverse Motor LED]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter><Parameter Name="Reverseslow" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><Description><![CDATA[Reverse Slow Motor LED]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter><Parameter Name="Temp2" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><Description><![CDATA[Temporary Variable LED]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter></Parameters>
<LocalTags><LocalTag Name="ForwardTimer" DataType="TIMER" ExternalAccess="Read/Write"><Description><![CDATA[Timer for Forward Motor]]></Description><DefaultData Format="Decorated"><Structure DataType="TIMER"><DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="10000"/><DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/><DataValueMember Name="EN" DataType="BOOL" Radix="Decimal" Value="0"/><DataValueMember Name="TT" DataType="BOOL" Radix="Decimal" Value="0"/><DataValueMember Name="DN" DataType="BOOL" Radix="Decimal" Value="0"/></Structure></DefaultData></LocalTag><LocalTag Name="ReverseTimer" DataType="TIMER" ExternalAccess="Read/Write"><Description><![CDATA[Timer for Reverse Motor]]></Description><DefaultData Format="Decorated"><Structure DataType="TIMER"><DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="10000"/><DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/><DataValueMember Name="EN" DataType="BOOL" Radix="Decimal" Value="0"/><DataValueMember Name="TT" DataType="BOOL" Radix="Decimal" Value="0"/><DataValueMember Name="DN" DataType="BOOL" Radix="Decimal" Value="0"/></Structure></DefaultData></LocalTag></LocalTags>
<Routines><Routine Name="Logic" Type="RLL"><RLLContent><Rung Number="0" Type="N"><Text><![CDATA[XIO(Stop)[XIC(Forward_PB),XIC(Temp1)]XIO(Reverse_PB)OTE(Temp1);]]></Text></Rung><Rung Number="1" Type="N"><Text><![CDATA[XIC(Temp1)XIO(ReverseTimer.DN)XIO(ForwardTimer.TT)[OTE(Forwardmtr),OTE(Forward)];]]></Text></Rung><Rung Number="2" Type="N"><Text><![CDATA[XIC(Forwardmtr)TOF(ForwardTimer,?,?);]]></Text></Rung><Rung Number="3" Type="N"><Text><![CDATA[XIC(ForwardTimer.TT)OTE(Forwardslow);]]></Text></Rung><Rung Number="4" Type="N"><Text><![CDATA[XIO(Stop)[XIC(Reverse_PB),XIC(Temp2)]XIO(Forward_PB)OTE(Temp2);]]></Text></Rung><Rung Number="5" Type="N"><Text><![CDATA[XIC(Temp2)XIO(ForwardTimer.DN)XIO(ReverseTimer.TT)[OTE(Reversemtr),OTE(Reverse)];]]></Text></Rung><Rung Number="6" Type="N"><Text><![CDATA[XIC(Reversemtr)TOF(ReverseTimer,?,?);]]></Text></Rung><Rung Number="7" Type="N"><Text><![CDATA[XIC(ReverseTimer.TT)OTE(Reverseslow);]]></Text></Rung></RLLContent></Routine></Routines>
